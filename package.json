{
  "name": "sonarr.tv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sonarr's Website",
  "scripts": {
    "prestart": "node --experimental-strip-types scripts/ensureDemo.mts",
    "start": "vite",
    "build:app": "node -e \"require('fs').rmSync('assets', { recursive: true, force: true })\" && vite build",
    "build": "yarn build:app && yarn build:demo && node --experimental-strip-types scripts/assembleSite.mts",
    "preview": "vite preview",
    "types:css": "tcm frontend/src --camelCase --pattern \"**/*.module.css\"",
    "typecheck": "yarn types:css && tsc --noEmit -p frontend/tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "eslint --config frontend/.eslintrc.cjs --ignore-path frontend/.eslintignore --ext .js,.cjs,.ts,.tsx,.mts frontend/ scripts/ vite.config.ts vite.demo.config.ts",
    "lint-fix": "yarn lint --fix",
    "stylelint": "stylelint \"frontend/**/*.css\" --config frontend/.stylelintrc",
    "build:demo": "node --experimental-strip-types scripts/buildDemo.mts",
    "build:demo-api": "vite build --config vite.demo.config.ts && node --experimental-strip-types scripts/finalizeDemo.mts",
    "build:shows": "node --experimental-strip-types scripts/buildShows.mts && node --experimental-strip-types scripts/finalizeDemo.mts"
  },
  "repository": "https://github.com/Sonarr/sonarr.github.io",
  "author": "Team Sonarr",
  "license": "BSD",
  "engines": {
    "node": ">=22.6.0"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "classnames": "2.5.1",
    "lucide-react": "0.511.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/eslint-parser": "7.28.6",
    "@csstools/postcss-global-data": "4.0.0",
    "@types/node": "24.13.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.0",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.37.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "postcss": "8.5.14",
    "postcss-custom-media": "12.0.1",
    "postcss-nested": "6.2.0",
    "prettier": "2.8.8",
    "sharp": "0.34.3",
    "stylelint": "15.6.1",
    "stylelint-order": "6.0.4",
    "typed-css-modules": "0.9.1",
    "typescript": "5.7.2",
    "typescript-plugin-css-modules": "5.0.1",
    "vite": "8.3.0",
    "vite-css-modules": "1.16.0"
  }
}
